[Unit]
Description=Network Device Watcher - Scanner
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=networkwatcher
WorkingDirectory=/opt/networkwatcher
EnvironmentFile=/opt/networkwatcher/.env
ExecStart=/opt/networkwatcher/venv/bin/python -m app.scanner_main
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
